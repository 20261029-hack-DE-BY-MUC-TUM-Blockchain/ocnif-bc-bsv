# Operational overlay identity only. Never use a customer's wallet key.
OVERLAY_PRIVATE_KEY=replace-with-distinct-64-hex-overlay-key
INTERNAL_TOKEN=replace-with-at-least-32-random-characters
OVERLAY_PORT=8097
OVERLAY_PUBLIC_URL=http://127.0.0.1:8097
OVERLAY_INTERNAL_URL=http://127.0.0.1:8097
OVERLAY_DB=/data/overlay.sqlite
BSV_MARKET_DB=/data/market.sqlite
BSV_MERCHANT_DB=/data/merchant.sqlite
BSV_NETWORK=main
ALLOWED_ORIGINS=http://localhost:3000
CHAINTRACKS_URL=https://arcade-v2-us-1.bsvblockchain.tech
ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
BACKEND_URL=http://127.0.0.1:8080
BSV_REPORT_SATOSHIS=100
BSV_PAYMENT_WINDOW_MS=300000
# Optional service earnings wallet. Distinct from overlay/customer wallets.
# Empty means direct BRC-121 sales are setup_required; no generated recipient.
BSV_MERCHANT_PRIVATE_KEY=
# Public BRC-100 identity of the user who may mint report access passes.
# Empty means pass registration is setup_required; no fabricated issuer.
BSV_ISSUER_IDENTITY_KEY=
# Local Compose image tag.
IMAGE_TAG=local
