{
  "name": "ocnif-bc-bsv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -p tsconfig.server.json",
    "test:server": "tsc -p tsconfig.server-test.json && node --test dist/server/*.test.js",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@bsv/402-pay": "0.3.3",
    "@bsv/overlay": "2.6.4",
    "@bsv/overlay-express": "2.7.4",
    "@bsv/sdk": "3.2.1",
    "@bsv/wallet-toolbox": "2.14.9",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "knex": "3.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "fake-indexeddb": "6.2.7",
    "typescript": "7.0.2"
  }
}
